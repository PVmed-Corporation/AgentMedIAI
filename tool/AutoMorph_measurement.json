{
  "tool_name": "AutoMorph_measurement",
  "tool_description": "AutoMorph_measurement is a Docker-based tool for automatic vascular morphology measurement from retinal fundus images. It supports multiple measurable features such as fractal dimension (FD) and vessel density (VD) across different vessel types (binary, artery, vein).",
  "tool_author": "Yukun Zhou",
  "tool_version": "latest",
  "tool_url": "https://hub.docker.com/r/yukunzhou/automorph-measurement",
  "demo_commands": [
    "docker pull yukunzhou/automorph-measurement:latest",
    "docker run --rm --shm-size=24g -v /path/to/input:/app/AutoMorph/input -v /path/to/output:/app/AutoMorph/output yukunzhou/automorph-measurement:latest --fd_binary --vd_binary --fd_artery --fd_vein --vd_artery --vd_vein",
    "docker run --rm --shm-size=24g -v /path/to/input:/app/AutoMorph/input -v /path/to/output:/app/AutoMorph/output yukunzhou/automorph-measurement:latest --fd_binary --vd_binary",
    "docker run --rm --shm-size=24g -v /path/to/input:/app/AutoMorph/input -v /path/to/output:/app/AutoMorph/output yukunzhou/automorph-measurement:latest"
  ],
  "input_schema": {
    "type": "object",
    "required": ["input", "output"],
    "properties": {
      "input": {
        "type": "string",
        "description": "Path to the input folder containing retinal fundus images."
      },
      "output": {
        "type": "string",
        "description": "Path to the output folder where the CSV results will be stored."
      },
      "measurement_flags": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "--fd_binary",
            "--vd_binary",
            "--fd_artery",
            "--fd_vein",
            "--vd_artery",
            "--vd_vein"
          ]
        },
        "description": "Optional flags to specify which measurements to perform. If no flags are provided, the tool will skip execution. If flags are omitted, default internal values will be used."
      }
    }
  },
  "measurement_options": {
    "fd_binary": "Fractal dimension (FD) for binary vessels",
    "vd_binary": "Vessel density (VD) for binary vessels",
    "fd_artery": "Fractal dimension (FD) for arteries",
    "fd_vein": "Fractal dimension (FD) for veins",
    "vd_artery": "Vessel density (VD) for arteries",
    "vd_vein": "Vessel density (VD) for veins"
  },
  "supported_datasets": [
    {
      "dataset_name": "MICCAI_FLARE_vessel",
      "Segmentation_labels": {
        "0": "background",
        "1": "vessel"
      },
      "Feature_labels": {
        "vessel_Fractal_Dimension": "fractal_dimension of vessels",
        "vessel_Vessel_Density": "vessel density of vessels"
      },
      "num_samples": 798,
      "file_ending": ".png",
      "license": "CC BY 4.0",
      "description": "FIVES: A Fundus Image Dataset for Artificial Intelligence based Vessel Segmentation",
      "source": "https://figshare.com/articles/figure/FIVES_A_Fundus_Image_Dataset_for_AI-based_Vessel_Segmentation/19688169/1"
    },
    {
      "dataset_name": "MICCAI_FLARE_artery_vein",
      "Segmentation_labels": {
        "0": "background",
        "1": "artery",
        "2": "vein",
        "3": "uncertain pixels"
      },
      "Feature_labels": {
        "artery_Fractal_Dimension": "fractal_dimension of artery vessels",
        "artery_Vessel_Density": "vessel density of artery vessels",
        "vein_Fractal_Dimension": "fractal_dimension of vein vessels",
        "vein_Vessel_Density": "vessel density of vein vessels"
      },
      "num_samples": 30,
      "file_ending": ".jpg",
      "license": "CC BY 4.0",
      "description": "The data is originally from DualModal2019 dataset and reorganised by The RETA Benchmark for Retinal Vascular Tree Analysis",
      "source": "https://reta-benchmark.org/dataset/, https://ieee-dataport.org/documents/dualmodal2019-dataset"
    }
  ]
}