{
  "tool_name": "OCT-Retinal-Layer-Segmenter",
  "tool_description": "UNet-based Keras/TensorFlow model that segments 8 retinal layers on single OCT B-scans; outputs multi-class mask.",
  "tool_author": "beasygo1ng (GitHub)",
  "tool_version": "master-18-commits",
  "tool_url": "https://github.com/beasygo1ng/OCT-Retinal-Layer-Segmenter",
  "demo_commands": [
    "python multiclass_segmentation.ipynb  # execute cells",
    "python predict.py --weights layer_unet.h5 --img scan.png --mask out.png"
  ],
  "input_schema": {
    "type": "object",
    "required": ["weights", "img"],
    "properties": {
      "weights": { "type": "string" },
      "img": { "type": "string" },
      "resize": { "type": "array", "items": { "type": "integer" }, "default": [512, 512] }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "mask_png": { "type": "string" }
    }
  },
  "class_maps": {
    "1": "NFL",
    "2": "GCL_IPL",
    "3": "INL",
    "4": "OPL",
    "5": "ONL",
    "6": "Ellipsoid",
    "7": "RPE",
    "8": "Choroid"
  },
  "license": "GPL-3.0"
}