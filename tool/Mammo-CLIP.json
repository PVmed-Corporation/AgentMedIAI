{
    "tool_name": "Mammo-CLIP",
    "tool_description": "Mammo-CLIP is a Vision Language Foundation Model that enhances data efficiency and robustness in mammography through zero-shot analysis. It provides state-of-the-art mammography analysis capabilities using vision-language understanding with customizable prompts for mass detection, malignancy assessment, breast density evaluation, and other mammographic features.",
    "tool_author": "Mammo-CLIP Team (Shen et al.)",
    "tool_version": "0.1.1",
    "tool_url": "https://pypi.org/project/mammoclip/0.1.1/",
    "demo_commands": [
        "# Basic mammography analysis with default prompts\nimport mammoclip\nmodel = mammoclip.MammoClipModel()\nresults = model.predict('mammogram.dcm')\nprint(results)",
        "# Custom analysis with specific prompts for mass and malignancy\nimport mammoclip\nmodel = mammoclip.MammoClipModel()\nresults = model.predict('mammogram.png', {\n    'mass': ['no mass', 'mass'],\n    'malignancy': ['no malignancy', 'malignancy']\n})\nprint(results)",
        "# Comprehensive analysis with density and other features\nimport mammoclip\nmodel = mammoclip.MammoClipModel()\nresults = model.predict('mammogram.dcm', {\n    'mass': ['no mass', 'mass'],\n    'malignancy': ['benign', 'malignant'],\n    'density': ['fatty', 'scattered areas of fibroglandular density', \n               'heterogeneously dense', 'extremely dense'],\n    'calcifications': ['no calcifications', 'calcifications present']\n})\nprint(results)",
        "# Command line interface usage\nmammoclip-inference --image mammogram.dcm",
        "# CLI with custom prompts file\nmammoclip-inference --image mammogram.png --prompts custom_prompts.json"
    ],
    "input_schema": {
        "type": "object",
        "required": [
            "image_path"
        ],
        "properties": {
            "image_path": {
                "type": "string",
                "description": "Path to the input mammogram image. Supports DICOM (.dcm, .dicom), PNG, JPEG, TIFF, BMP formats."
            },
            "prompts": {
                "type": "object",
                "default": {
                    "mass": ["no mass", "mass"],
                    "malignancy": ["no malignancy", "malignancy"],
                    "density": ["fatty", "scattered areas of fibroglandular density", "heterogeneously dense", "extremely dense"]
                },
                "description": "Custom prompts for zero-shot analysis. Each key represents a feature to analyze, with values being possible text descriptions.",
                "additionalProperties": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "model_config": {
                "type": "object",
                "default": {},
                "description": "Model configuration parameters",
                "properties": {
                    "device": {
                        "type": "string",
                        "enum": ["auto", "cpu", "cuda"],
                        "default": "auto",
                        "description": "Device to run inference on"
                    },
                    "batch_size": {
                        "type": "integer",
                        "minimum": 1,
                        "default": 1,
                        "description": "Batch size for inference"
                    }
                }
            },
            "output_format": {
                "type": "string",
                "enum": ["json", "csv"],
                "default": "json",
                "description": "Output format for results"
            },
            "confidence_threshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.5,
                "description": "Confidence threshold for predictions"
            }
        }
    },
    "output_schema": {
        "type": "object",
        "properties": {
            "image_path": {
                "type": "string",
                "description": "Path to the analyzed image"
            },
            "predictions": {
                "type": "object",
                "description": "Predictions for each prompt category",
                "additionalProperties": {
                    "type": "object",
                    "properties": {
                        "predicted_class": {
                            "type": "string",
                            "description": "Predicted class with highest confidence"
                        },
                        "confidence_scores": {
                            "type": "object",
                            "description": "Confidence scores for each possible class",
                            "additionalProperties": {
                                "type": "number"
                            }
                        },
                        "raw_scores": {
                            "type": "object",
                            "description": "Raw model scores before normalization",
                            "additionalProperties": {
                                "type": "number"
                            }
                        }
                    }
                }
            },
            "model_info": {
                "type": "object",
                "properties": {
                    "model_name": {
                        "type": "string",
                        "description": "Name of the Mammo-CLIP model used"
                    },
                    "version": {
                        "type": "string",
                        "description": "Version of the mammoclip package"
                    },
                    "device_used": {
                        "type": "string",
                        "description": "Device used for inference"
                    }
                }
            },
            "processing_info": {
                "type": "object",
                "properties": {
                    "image_format": {
                        "type": "string",
                        "description": "Format of the input image"
                    },
                    "image_size": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        },
                        "description": "Dimensions of the processed image [height, width]"
                    },
                    "processing_time": {
                        "type": "number",
                        "description": "Time taken for inference in seconds"
                    }
                }
            }
        }
    },
    "supported_datasets": [
        "DICOM mammograms",
        "Digital mammography images",
        "Standard medical imaging formats"
    ],
    "supported_formats": [
        "DICOM (.dcm, .dicom)",
        "PNG (.png)",
        "JPEG (.jpg, .jpeg)",
        "TIFF (.tiff, .tif)",
        "BMP (.bmp)"
    ],
    "license": "MIT",
    "reference": "@article{shen2024mammoclip,\n  title={Mammo-CLIP: A Vision Language Foundation Model to Enhance Data Efficiency and Robustness in Mammography},\n  author={Shen, Shantanu and Xu, Haoyue and Weng, Jaden and Wu, Jay and Chen, Evangelia and Abbasi, Salma and Wang, Rayna and Bouzid, Hania and Rajpurkar, Pranav},\n  journal={arXiv preprint arXiv:2409.03675},\n  year={2024}\n}",
    "installation": {
        "method": "pip",
        "command": "pip install mammoclip==0.1.1",
        "requirements": "Python >=3.8"
    },
    "features": [
        "Zero-shot mammography analysis",
        "Vision-language foundation model",
        "Customizable text prompts",
        "Multi-format image support",
        "Mass detection and classification",
        "Breast density assessment",
        "Malignancy evaluation",
        "DICOM support",
        "Command line interface",
        "Python API"
    ]
} 