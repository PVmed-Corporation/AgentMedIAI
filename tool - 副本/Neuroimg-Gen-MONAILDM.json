{
  "tool_name": "BrainImageSynthLDM",
  "tool_description": "This tool generates synthetic 3D brain MRI volumes using a Latent Diffusion Model (LDM) trained on UK Biobank data. Generation is conditioned on demographic and anatomical attributes including gender, age, ventricular volume, and brain volume.",
  "tool_author": "Walter H. L. Pinaya et al.",
  "tool_version": "1.0",
  "tool_url": "https://github.com/Project-MONAI/GenerativeModels/tree/main/model-zoo/models/brain_image_synthesis_latent_diffusion_model",
  "demo_commands": [
    "python -m monai.bundle run save_nii \\",
    "--config_file model-zoo/models/brain_image_synthesis_latent_diffusion_model/configs/inference.json \\",
    "--bundle_root /content/drive/MyDrive/Flareagent/tools/MONAILDM \\",
    "--gender 1.0 --age 0.7 --ventricular_vol 0.7 --brain_vol 0.5"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "gender",
      "age",
      "ventricular_vol",
      "brain_vol",
      "bundle_root"
    ],
    "properties": {
      "gender": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "description": "Gender conditioning input: 0.0 = female, 1.0 = male."
      },
      "age": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "description": "Normalized age input (0–1 range based on population distribution)."
      },
      "ventricular_vol": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "description": "Normalized ventricular CSF volume (0–1)."
      },
      "brain_vol": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "description": "Normalized brain volume (0–1)."
      },
      "bundle_root": {
        "type": "string",
        "description": "Path to the MONAI bundle directory containing model checkpoints and configs."
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "generated_image": {
        "type": "string",
        "description": "Path to the generated synthetic brain MRI NIfTI file (typically under `outputs/`)."
      }
    }
  },
  "execution": {
    "type": "shell",
    "entrypoint_template": "python -m monai.bundle run save_nii --config_file model-zoo/models/brain_image_synthesis_latent_diffusion_model/configs/inference.json --bundle_root \"{bundle_root}\" --gender {gender} --age {age} --ventricular_vol {ventricular_vol} --brain_vol {brain_vol}"
  },
  "data_requirements": {
    "format": "N/A",
    "preprocessing": [
      "None; generation is fully synthetic and conditioned."
    ]
  }
}
