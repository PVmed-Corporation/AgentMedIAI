{
    "tool_name": "ultrasegmentator",
    "tool_description": "ultrasegmentator is a medical ultrasound image segmentation tool that supports multiple segmentation tasks, including CAMUS_Left_Heart, Four_Chamber_Heart, Carotid_Artery, Thyroid_Nodule, Thyroid_Gland, Fetal_Head, Fetal_Abdomen, and Breast_Nodule.",
    "tool_author": "Xin Yang, Junxuan Yu, Yongsong Zhou, Tong Han, Zhiyuan Zhu, Tong Zhang, Jiongquan Chen",
    "tool_version": "0.2.0",
    "tool_url": "",
    "demo_commands": [
        "ultrasegmentator -i input_file_or_dir -o output_dir -t CAMUS_Left_Heart -d gpu",
        "ultrasegmentator -i input_file_or_dir -o output_dir -t Four_Chamber_Heart -d cpu",
        "ultrasegmentator -i input_file_or_dir -o output_dir -t Carotid_Artery -d gpu:0"

    ],
    "input_schema": {
        "type": "object",
        "required": [
            "input",
            "output",
            "task"
        ],
        "properties": {
            "input": {
                "type": "string",
                "description": "Input file/directory path (must be a valid existing path)"
            },
            "output": {
                "type": "string",
                "description": "Output directory path (required for saving results)"
            },
            "task": {
                "type": "string",
                "enum": [
                    "CAMUS_Left_Heart",
                    "Four_Chamber_Heart",
                    "Carotid_Artery",
                    "Thyroid_Nodule",
                    "Thyroid_Gland",
                    "Fetal_Head",
                    "Fetal_Abdomen",
                    "Breast_Nodule"
                ],
                "description": "Segmentation task name"
            },
            "device": {
                "type": "string",
                "description": "Computation device. Options: 'gpu', 'cpu', 'mps' or 'gpu:X' (X is GPU ID)",
                "default": "gpu"
            }
        }
    },
    "output_schema": {
        "type": "object",
        "properties": {
            "segmentation_files": {
                "type": "array",
                "items": {
                    "type": "string"
                },
                "description": "List of file paths to the generated segmentation masks."
            }
        }
    },
    "class_maps": {
        "CAMUS_Left_Heart": {
            "0": "background",
            "1": "LV",
            "2": "Myo",
            "3": "LA"
        },
        "Four_Chamber_Heart": {
            "0": "background",
            "1": "LV",
            "2": "LA",
            "3": "RA",
            "4": "RV"
        },
        "Carotid_Artery": {
            "0": "background",
            "1": "Carotid_Artery"
        },
        "Thyroid_Nodule": {
            "0": "background",
            "1": "Thyroid_Nodule"
        },
        "Thyroid_Gland": {
            "0": "background",
            "1": "Thyroid_Gland"
        },
        "Fetal_Head": {
            "0": "background",
            "1": "LV",
            "2": "CSP",
            "3": "Brain"
        },
        "Fetal_Abdomen": {
            "0": "background",
            "1": "liver",
            "2": "artery",
            "3": "vein",
            "4": "stomach"
        },
        "Breast_Nodule": {
            "0": "background",
            "1": "Breast_Nodule"
        }
    }
}