{
    "tool_name": "Ultraclassifier",
    "tool_description": "Ultraclassifier is a medical ultrasound image classification tool leveraging ConvNeXt and CLIP architectures, supporting multi-class classification for various anatomical structures and pathologies.",
    "tool_author": "Xin Yang, Junxuan Yu, Yongsong Zhou, Tong Han, Zhiyuan Zhu, Tong Zhang, Jiongquan Chen",
    "tool_version": "0.2.4",
    "tool_url": "Not provided",
    "demo_commands": [
        "ultraclassifier -i /path/to/ultrasound_images -o /path/to/results -t All_planes -d gpu:0",
        "ultraclassifier -i single_image.jpg -o output_dir -t Thyroid_Nodule -d cpu",
        "ultraclassifier -i breast_scans/ -o predictions -t Breast_Nodule -d mps"
    ],
    "input_schema": {
        "type": "object",
        "required": [
            "input",
            "output",
            "task"
        ],
        "properties": {
            "input": {
                "type": "string",
                "description": "Path to input image file or directory containing images"
            },
            "output": {
                "type": "string",
                "description": "Directory to save classification results (JSON files)"
            },
            "task": {
                "type": "string",
                "enum": [
                    "All_planes",
                    "Thyroid_Nodule",
                    "Breast_Nodule"
                ],
                "description": "Classification task type"
            },
            "device": {
                "type": "string",
                "description": "Computation device (e.g., 'gpu', 'cpu', 'mps', 'gpu:X')",
                "default": "gpu:1"
            }
        }
    },
    "output_schema": {
        "type": "object",
        "properties": {
            "results_directory": {
                "type": "string",
                "description": "Root output directory: {output_dir}"
            },
            "prediction_files": {
                "type": "array",
                "items": {
                    "type": "string"
                },
                "description": "List of JSON files containing classification results (e.g., {output_dir}/image_name.json)"
            },
            "prediction_structure": {
                "type": "object",
                "properties": {
                    "image": {
                        "type": "string",
                        "description": "Input image filename"
                    },
                    "label": {
                        "type": "string",
                        "description": "Predicted class label"
                    },
                    "score": {
                        "type": "number",
                        "description": "Confidence score for the prediction"
                    }
                },
                "description": "Structure of the generated JSON prediction files"
            }
        }
    },
    "class_maps": {
        "All_planes": {
            "0": "Breast_Nodule",
            "1": "Heart",
            "2": "Fetal_abdomen",
            "3": "Fetal_Head",
            "4": "Fetal_NT",
            "5": "Thyroid_or_Caroid"
        },
        "Thyroid_Nodule": {
            "0": "benign",
            "1": "Malignant"
        },
        "Breast_Nodule": {
            "0": "benign",
            "1": "Malignant",
            "2": "normal"
        }
    }
}