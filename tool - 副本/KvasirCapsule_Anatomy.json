
{
  "tool_name": "timm",
  "tool_description": "Timm (PyTorch Image Models) is a comprehensive deep learning library providing state-of-the-art pre-trained computer vision models, training scripts, and inference utilities for researchers and practitioners.",
  "tool_author": "Ross Wightman et al.",
  "tool_version": "1.0.15",
  "tool_url": "https://github.com/rwightman/pytorch-image-models",
  "demo_commands": [
    "python inference_anatomy.py --image-path /content/XXXXX_003351.jpg --ckpt /content/SwinTransformerV2/2025-06-19-17-11-50-Anatomy/Val_Epoch058-Acc99.127.pth"
  ],
      "input_schema": {
        "type": "object",
        "required": [
            "input",
            "output"
        ],
        "properties": {
            "input": {
                "type": "string",
                "description": "Path to input image file"
            },
            "output": {
                "type": "string",
                "description": "Classfication results"
            },
            "device": {
                "type": "string",
                "description": "GPU id number",
                "default": "0"
            }
        }
    },
    "output_schema": {
        "type": "object",
        "properties": {
            "results": {
                "type": "string",
                "description": "Clasification results"
            },
            "prediction_structure": {
                "type": "object",
                "properties": {
                    "image": {
                        "type": "string",
                        "description": "Input image path"
                    },
                    "label": {
                        "type": "string",
                        "description": "Predicted class label"
                    },
                    "score": {
                        "type": "number",
                        "description": "Probability for the prediction"
                    }
                },
                "description": "Structure of the prediction results"
            }
        }
    },
    "class_maps": {
        "anatomy": {
        "0": "AmpullaOfVater",
        "1": "IleocecalValve",
        "2": "Pylorus"
        }
    }
}