{
  "tool_name": "Choroidalyzer",
  "tool_description": "End-to-end Python pipeline that segments choroid region, vessels and fovea, then outputs choroidal thickness / area / vascular index maps from OCT B-scans.",
  "tool_author": "Justin Engelmann et al.",
  "tool_version": "0.5.0",
  "tool_url": "https://github.com/justinengelmann/Choroidalyzer",
  "demo_commands": [
    "pip install -r requirements.txt",
    "python choroidalyzer.py --in Bscan.png --out results/"
  ],
  "input_schema": {
    "type": "object",
    "required": ["in", "out"],
    "properties": {
      "in": { "type": "string", "description": "Single B-scan or folder." },
      "out": { "type": "string" },
      "device": { "type": "string", "enum": ["cpu", "cuda"], "default": "cuda" }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "choroid_mask": { "type": "string" },
      "vessel_mask": { "type": "string" },
      "metrics_json": { "type": "string" }
    }
  },
  "class_maps": { "1": "choroid_region", "2": "choroidal_vessels" },
  "license": "BSD-3-Clause"
}